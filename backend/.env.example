# Kairo backend 環境変数サンプル
#
# 使い方: このファイルを同じディレクトリに `.env` という名前でコピーしてください。
#   PowerShell: Copy-Item .env.example .env
#
# ここに書かれている値はすべて「デフォルト値」です。
# 変更が不要な項目はそのままコメントアウトしておいて構いません
# （未設定の場合は app/core/config.py のデフォルト値が使われます）。

# ---- データ保存先 ----
# 動画素材・レンダリング結果・SQLite DB・ログを保存するディレクトリ。
# 未設定の場合はリポジトリ直下の `data/` フォルダが使われます。
# KAIRO_DATA_ROOT=C:\Users\you\Kairo-data

# ---- ローカルAI (LM Studioなど、OpenAI互換APIサーバー) ----
# LM StudioのLocal Serverを起動した際に表示されるベースURL。
KAIRO_LLM_BASE_URL=http://localhost:1234/v1

# 任意。未設定の場合、Kairoが起動時にLM Studioから利用可能なモデルを自動検出し、
# PC性能に応じて推奨されるモデルを自動選択します（Kairo UIの「設定 > AI」からも
# Auto/Manualの切り替え・モデル変更が可能です）。特定のモデルを強制したい場合のみ
# ここにLM Studio上の実際のモデルIDを指定してください。
# KAIRO_LLM_MODEL=

# LLMへのリクエストのタイムアウト（秒）。
# ローカルLLMをCPU/内蔵GPUで動かす場合、7B級モデルの脚本生成は1リクエストに
# 数分かかることがあります。短すぎると制作が途中で失敗するため、既定は600秒です。
# 高速なGPUを使っていて失敗を早く検知したい場合のみ短くしてください。
KAIRO_LLM_TIMEOUT=600

# ---- 音声文字起こし (faster-whisper) ----
# モデルサイズ: tiny / base / small / medium / large-v3 など。
# 大きいほど高精度・低速・高メモリ消費。初回実行時にHugging Faceから自動ダウンロードされます。
KAIRO_WHISPER_MODEL=small

# 実行デバイス: cpu または cuda（NVIDIA GPU + CUDA環境がある場合）。
KAIRO_WHISPER_DEVICE=cpu

# 演算精度。int8はCPUでの高速・省メモリ動作に向いています。
KAIRO_WHISPER_COMPUTE=int8

# ---- サーバーの待受アドレス/ポート (npm run dev / npm run start が参照) ----
# バックエンド(FastAPI)を起動する待受アドレス。LAN内の別端末に公開する場合のみ 0.0.0.0 にする。
# KAIRO_HOST=127.0.0.1

# バックエンド(FastAPI)の待受ポート。
# KAIRO_PORT=8756

# ---- LAN内の別端末からアクセスする場合のみ ----
# バックエンドへのアクセスを許可する追加オリジン（カンマ区切り、通常は不要）。
# フロントエンドをLAN公開する場合、そのURLをここに追加してください。
# 例: KAIRO_CORS_ORIGINS=http://192.168.1.20:5173
# KAIRO_CORS_ORIGINS=
